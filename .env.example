# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Your LLM provider API key
# Groq (free, fast): https://console.groq.com/keys
# OpenAI: https://platform.openai.com/api-keys
API_TOKEN=your_api_key_here

# Base URL for any OpenAI-compatible provider
# Groq:   https://api.groq.com/openai/v1
# OpenAI: https://api.openai.com/v1
# Ollama: http://localhost:11434/v1
API_BASE_URL=https://api.groq.com/openai/v1

# Model name for your chosen provider
# Groq models:  llama-3.3-70b-versatile | mixtral-8x7b-32768 | llama3-8b-8192
# OpenAI models: gpt-4o | gpt-4o-mini | gpt-3.5-turbo
MODEL_NAME=llama-3.3-70b-versatile
